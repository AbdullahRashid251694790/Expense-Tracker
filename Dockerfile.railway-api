FROM node:22-slim

# Install pnpm
RUN npm install -g pnpm@8.15.1

WORKDIR /app

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/tracker-api/package.json ./apps/tracker-api/

# Install dependencies (including devDependencies for tsx)
RUN pnpm install --frozen-lockfile=false

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/tracker-api ./apps/tracker-api
COPY tsconfig.base.json ./

# Build shared package
RUN pnpm --filter @casha/shared build || true

WORKDIR /app/apps/tracker-api

# Expose port
EXPOSE 3000

# Start with tsx (runs TypeScript directly without compilation)
CMD ["npx", "tsx", "src/index.ts"]
