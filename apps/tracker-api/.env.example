# =============================================================================
# Casha Tracker API - Environment Configuration (PostgreSQL Version)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Environment: development | production | test
NODE_ENV=development

# API server port
API_PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------

# Database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://casha:casha_dev_password@localhost:5432/casha

# -----------------------------------------------------------------------------
# JWT Authentication Configuration
# -----------------------------------------------------------------------------

# Secret key for signing access tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# Access token expiration (e.g., 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# Secret key for signing refresh tokens (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-characters

# Refresh token expiration (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# AI Integration (Required for AI features)
# -----------------------------------------------------------------------------

# OpenRouter API key for AI-powered insights
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenRouter model to use (default: anthropic/claude-3-haiku)
# Options: anthropic/claude-3-haiku, openai/gpt-3.5-turbo, etc.
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Application URL (used for OpenRouter referer header)
APP_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Email Configuration (Required for password reset)
# -----------------------------------------------------------------------------

# SMTP server hostname
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# SendGrid: smtp.sendgrid.net
SMTP_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS (true for port 465, false for port 587 with STARTTLS)
SMTP_SECURE=false

# SMTP authentication username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP authentication password
# For Gmail: Use an App Password (not your regular password)
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password here (without spaces)
SMTP_PASS=your-app-password

# From address for outgoing emails
SMTP_FROM=your-email@gmail.com
